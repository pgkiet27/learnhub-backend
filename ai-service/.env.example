# Database
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5438/ai_db

# LLM Provider — đổi "gemini" thành "claude" để chuyển sang Claude, không cần sửa code
LLM_PROVIDER=gemini

# API key — điền key thật vào file .env (không phải file này)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx     # lấy tại aistudio.google.com/apikey
                                                 # dùng cho cả Embedding lẫn Chat (Gemini free tier)

# Model config
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.5-flash
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K_RESULTS=3

# Other LearnHub services (host defaults; overridden in docker-compose.apps.yml)
ENROLLMENT_SERVICE_URL=http://localhost:8084
ENROLLMENT_CHECK_ENABLED=true
COURSE_DB_URL=postgresql://learnhub:learnhub123@localhost:5435/course_db   # index_from_course_db.py only

# Churn model: "local" = churn_prediction/models, "sagemaker" = endpoint deployed by the MLOps pipeline
CHURN_MODEL_BACKEND=local
CHURN_SAGEMAKER_ENDPOINT=learnhub-churn
AWS_REGION=us-east-1
# AWS_PROFILE=learnhub-dev   # local runs only; on EKS use an IRSA role with sagemaker:InvokeEndpoint
