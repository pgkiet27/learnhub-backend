# Leave unset for local dev: emails go to Mailpit (http://localhost:8025)
# For real delivery (e.g. Gmail SMTP with an app password, or Amazon SES SMTP):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=LearnHub <your-account@gmail.com>
