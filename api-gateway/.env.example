# Must be the same value as identity-service JWT_SECRET
JWT_SECRET=learnhub-super-secret-key-change-in-production-must-be-256-bits

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Downstream services (defaults are the local ports)
IDENTITY_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
COURSE_SERVICE_URL=http://localhost:8083
ENROLLMENT_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
