# Database
DB_USER=learnhub
DB_PASSWORD=learnhub123

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Course Service URL
COURSE_SERVICE_URL=http://localhost:8083

# Churn dataset export to S3 (training data for the MLOps pipeline)
# Local runs write to churn/dev/ so they never overwrite the real dataset in churn/features and churn/labels
CHURN_EXPORT_ENABLED=false
CHURN_EXPORT_BUCKET=learnhub-ml-abc123
CHURN_EXPORT_PREFIX=churn/dev
AWS_PROFILE=learnhub-dev
AWS_REGION=us-east-1
